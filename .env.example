# Copy this file to .env and fill in your Supabase project's values
# (Project Settings -> API in the Supabase dashboard).
# The anon key is safe to expose client-side by design — it's not a secret,
# access control is enforced by Postgres Row Level Security instead.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
